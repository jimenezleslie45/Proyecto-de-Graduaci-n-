# ============================================
# CONFIGURACIÓN SMTP PARA ENVÍO DE FACTURAS
# ============================================
# IMPORTANTE: Para que la factura llegue al correo del huésped,
# debes configurar estas variables en tu archivo .env
#
# Para Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=tu-correo@gmail.com
#   SMTP_PASSWORD=tu-contraseña-de-aplicacion   (NO es la contraseña normal, genera una "App Password" en Google)
#   EMAIL_FROM=Hotel Los Arcos <tu-correo@gmail.com>

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=REEMPLAZAR_CON_TU_CORREO
SMTP_PASSWORD=REEMPLAZAR_CON_TU_CONTRASEÑA_APP
EMAIL_FROM=Hotel Los Arcos <REEMPLAZAR_CON_TU_CORREO>
